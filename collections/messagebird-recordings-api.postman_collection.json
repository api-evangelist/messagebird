  "info": {
    "_postman_id": "ffd0dd3e-b202-46a3-86ba-a877ba258959",
    "name": "MessageBird Balance Available Numbers Recordings API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The MessageBird Balance API provides developers with access to their account balance information. It returns the current payment type, available amount, and currency for the account associated with the API key. This API is useful for monitoring credit usage, building billing dashboards, and setting up automated alerts when account balances fall below a threshold.\n\nContact Support:\n Name: MessageBird Support",
      "type": "text/plain"
    }
  }

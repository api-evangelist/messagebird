    "_postman_id": "231f2603-ab59-4618-b0d6-90006081e916",
    "name": "MessageBird Integrations API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The MessageBird Integrations API allows developers to create, fetch, and delete message templates for supported platforms. It currently supports template management for the WhatsApp platform, enabling developers to programmatically manage the templates required for sending WhatsApp Business notifications and messages. The API handles template submission, approval status tracking, and lifecycle management.\n\nContact Support:\n Name: MessageBird Support",
      "type": "text/plain"
    }
  }

  "info": {
    "_postman_id": "475a4a8d-b20a-419e-b023-559893444920",
    "name": "MessageBird HLR API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The MessageBird HLR API provides a way to send Home Location Register network queries to any mobile number globally. It allows developers to determine which operator a mobile number belongs to in real-time and check whether the number is currently active on the network. This API is commonly used for number portability checks, fraud prevention, and optimizing message routing.\n\nContact Support:\n Name: MessageBird Support",
      "type": "text/plain"
    }
  }

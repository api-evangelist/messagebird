    "_postman_id": "23a979f9-6374-40d2-8794-010b3913e2ca",
    "name": "MessageBird Numbers API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The MessageBird Numbers API enables developers to search for, purchase, and manage phone numbers programmatically. It supports local, toll-free, and mobile number types across multiple countries, with the ability to filter by pattern, type, and region. Purchased numbers can be configured for SMS and voice capabilities and assigned to specific messaging or calling workflows.\n\nContact Support:\n Name: MessageBird Support",
      "type": "text/plain"
    }
  }

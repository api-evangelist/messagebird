{
  "opencollection": "1.0.0",
  "info": {
    "name": "MessageBird Balance Available Numbers API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Available Numbers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search available phone numbers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://rest.messagebird.com/available-phone-numbers/:countryCode",
            "params": [
              {
                "name": "countryCode",
                "value": "",
                "type": "path",
                "description": "The two-letter ISO 3166-1 country code to search in."
              },
              {
                "name": "features",
                "value": "",
                "type": "query",
                "description": "Filter by number features."
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Filter by number type."
              },
              {
                "name": "searchPattern",
                "value": "",
                "type": "query",
                "description": "A pattern to search for in available numbers."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "The maximum number of results to return."
              }
            ]
          },
          "docs": "Searches for available phone numbers that can be purchased in the specified country. Results can be filtered by number type, features, and search pattern."
        }
      ]
    }
  ],
  "bundled": true
}
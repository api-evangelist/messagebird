{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/WhatsAppReply",
  "title": "WhatsAppReply",
  "type": "object",
  "required": [
    "type",
    "content"
  ],
  "properties": {
    "type": {
      "type": "string",
      "description": "The type of reply content.",
      "enum": [
        "text",
        "image",
        "video",
        "audio",
        "file",
        "location",
        "hsm",
        "interactive"
      ]
    },
    "content": {
      "$ref": "#/components/schemas/WhatsAppContent"
    }
  }
}